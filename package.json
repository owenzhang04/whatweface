{
  "name": "whatweface",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "eslint . && prettier --check .",
    "lint:content": "node scripts/lint-content.ts",
    "format": "prettier --write .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm lint:content && pnpm test",
    "test:e2e": "playwright test",
    "fetch-data": "node scripts/fetch-data.ts",
    "test:gate": "node scripts/check-build-gate.ts",
    "lighthouse": "lhci autorun --config=lighthouserc.cjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.3",
    "@observablehq/plot": "^0.6.17",
    "astro": "^7.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "linkedom": "^0.18.13",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
