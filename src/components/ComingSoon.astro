---
import { repoFile } from "../lib/site";

interface Props {
  what: string;
}

const { what } = Astro.props;
---

<section class="coming-soon" aria-label="Status">
  <p class="mono">Coming soon</p>
  <p>
    {what} isn't written yet. You can follow progress in the
    <a href={repoFile("docs/PLAN.md")}>project plan</a>.
  </p>
</section>

<style>
  .coming-soon {
    border: 1px solid var(--muted);
    padding: var(--space-5);
    max-width: var(--measure);
  }

  .coming-soon .mono {
    margin: 0 0 var(--space-2);
    color: var(--muted);
  }

  .coming-soon p:last-child {
    margin: 0;
  }
</style>
