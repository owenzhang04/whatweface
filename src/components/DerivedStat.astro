---
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<p class="derived">
  {text}
  <a class="label mono" href="/method#derived">
    Derived
  </a>
</p>

<style>
  .derived {
    font-size: 1.25rem;
    margin: var(--space-3) 0 0;
  }

  .label {
    margin-left: var(--space-2);
    color: var(--muted);
    font-size: 0.6875rem;
    vertical-align: middle;
  }
</style>
