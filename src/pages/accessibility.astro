---
import BaseLayout from "../layouts/BaseLayout.astro";
import ComingSoon from "../components/ComingSoon.astro";
import { NEW_ISSUE_URL } from "../lib/site";
---

<BaseLayout
  title="Accessibility"
  description="Accessibility statement for What We Face and how to report a problem."
>
  <h1>Accessibility</h1>
  <p>
    This site aims to meet the Web Content Accessibility Guidelines (WCAG) 2.2 at level AA. If
    something doesn't work for you, <a href={NEW_ISSUE_URL}>open an issue</a> and describe what
    happened.
  </p>
  <ComingSoon what="The full accessibility statement" />
</BaseLayout>
